// RUN: ptoas --pto-level=level2 --pto-arch=a3 \
// RUN:   --emit-pto-ir --mlir-print-ir-after=pto-plan-memory %s 2>&1 \
// RUN:   | FileCheck %s

module attributes {"pto.target_arch" = "a3"} {
  func.func @five_gates_phi_family_select(
      %gm0 : !pto.ptr<f16>, %gm1 : !pto.ptr<f16>, %gm2 : !pto.ptr<f16>,
      %out : !pto.ptr<f16>, %outer_cond : i1, %inner_cond : i1) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %gm0_view = pto.make_tensor_view %gm0,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c16, %c16, %c16, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf16>
    %gm1_view = pto.make_tensor_view %gm1,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c16, %c16, %c16, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf16>
    %gm2_view = pto.make_tensor_view %gm2,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c16, %c16, %c16, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf16>
    %out_view = pto.make_tensor_view %out,
      shape = [%c1, %c1, %c1, %c16, %c16],
      strides = [%c16, %c16, %c16, %c16, %c1]
      : !pto.tensor_view<1x1x1x16x16xf16>
    %gm0_part = pto.partition_view %gm0_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf16>
     -> !pto.partition_tensor_view<1x1x1x16x16xf16>
    %gm1_part = pto.partition_view %gm1_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf16>
     -> !pto.partition_tensor_view<1x1x1x16x16xf16>
    %gm2_part = pto.partition_view %gm2_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf16>
     -> !pto.partition_tensor_view<1x1x1x16x16xf16>
    %out_part = pto.partition_view %out_view,
      offsets = [%c0, %c0, %c0, %c0, %c0],
      sizes = [%c1, %c1, %c1, %c16, %c16]
      : !pto.tensor_view<1x1x1x16x16xf16>
     -> !pto.partition_tensor_view<1x1x1x16x16xf16>

    %merged = scf.if %outer_cond -> (!pto.tile_buf<vec, 16x16xf16>) {
      %a = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
      %b = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%gm0_part : !pto.partition_tensor_view<1x1x1x16x16xf16>)
                outs(%a : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
      pto.tload ins(%gm1_part : !pto.partition_tensor_view<1x1x1x16x16xf16>)
                outs(%b : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
      %selected = arith.select %inner_cond, %a, %b
        : !pto.tile_buf<vec, 16x16xf16>
      scf.yield %selected : !pto.tile_buf<vec, 16x16xf16>
    } else {
      %c = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%gm2_part : !pto.partition_tensor_view<1x1x1x16x16xf16>)
                outs(%c : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
      scf.yield %c : !pto.tile_buf<vec, 16x16xf16>
    }

    pto.tstore ins(%merged : !pto.tile_buf<vec, 16x16xf16>)
               outs(%out_part : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
    return
  }
}

// CHECK-LABEL: func.func @five_gates_phi_family_select
// CHECK-DAG: %[[ADDR0:.*]] = arith.constant 0 : i64
// CHECK-DAG: %[[ADDR1:.*]] = arith.constant 512 : i64
// CHECK: scf.if
// CHECK: pto.alloc_tile addr = %[[ADDR0]]
// CHECK: pto.alloc_tile addr = %[[ADDR1]]
// CHECK: arith.select
// CHECK: } else {
// CHECK: pto.alloc_tile addr = %[[ADDR0]]
// CHECK-NOT: memref.alloc
