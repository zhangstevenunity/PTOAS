// RUN: ptoas --pto-level=level2 --pto-arch=a3 \
// RUN:   --emit-pto-ir --mlir-print-ir-after=pto-plan-memory %s 2>&1 \
// RUN:   | FileCheck %s

module attributes {pto.target_arch = "a3"} {
  func.func @execute_region_result_alias_no_reuse(
      %src0: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %src1: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %dst: !pto.partition_tensor_view<1x1x1x16x16xf16>) {
    %escaped = scf.execute_region -> !pto.tile_buf<vec, 16x16xf16> {
      %live = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%src0 : !pto.partition_tensor_view<1x1x1x16x16xf16>)
                outs(%live : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
      scf.yield %live : !pto.tile_buf<vec, 16x16xf16>
    }

    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src1 : !pto.partition_tensor_view<1x1x1x16x16xf16>)
              outs(%scratch : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
    pto.tstore ins(%scratch : !pto.tile_buf<vec, 16x16xf16>)
               outs(%dst : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
    pto.tstore ins(%escaped : !pto.tile_buf<vec, 16x16xf16>)
               outs(%dst : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
    return
  }

  func.func @while_result_and_backedge_alias_no_reuse(
      %src0: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %src1: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %src2: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %dst: !pto.partition_tensor_view<1x1x1x16x16xf16>,
      %keep_going: i1) {
    %init = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src0 : !pto.partition_tensor_view<1x1x1x16x16xf16>)
              outs(%init : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}

    %result = scf.while (%carried = %init)
        : (!pto.tile_buf<vec, 16x16xf16>) -> !pto.tile_buf<vec, 16x16xf16> {
      scf.condition(%keep_going) %carried : !pto.tile_buf<vec, 16x16xf16>
    } do {
    ^bb0(%body: !pto.tile_buf<vec, 16x16xf16>):
      pto.tstore ins(%body : !pto.tile_buf<vec, 16x16xf16>)
                 outs(%dst : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
      %next = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%src1 : !pto.partition_tensor_view<1x1x1x16x16xf16>)
                outs(%next : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
      scf.yield %next : !pto.tile_buf<vec, 16x16xf16>
    }

    %scratch = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%src2 : !pto.partition_tensor_view<1x1x1x16x16xf16>)
              outs(%scratch : !pto.tile_buf<vec, 16x16xf16>) {layout = #pto.layout<nd>}
    pto.tstore ins(%scratch : !pto.tile_buf<vec, 16x16xf16>)
               outs(%dst : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
    pto.tstore ins(%result : !pto.tile_buf<vec, 16x16xf16>)
               outs(%dst : !pto.partition_tensor_view<1x1x1x16x16xf16>) {layout = #pto.layout<nd>}
    return
  }
}

// CHECK-LABEL: func.func @execute_region_result_alias_no_reuse
// CHECK-DAG: %[[EXEC_LIVE_ADDR:.*]] = arith.constant 0 : i64
// CHECK-DAG: %[[EXEC_SCRATCH_ADDR:.*]] = arith.constant 512 : i64
// CHECK: scf.execute_region
// CHECK: pto.alloc_tile addr = %[[EXEC_LIVE_ADDR]]
// CHECK: scf.yield
// CHECK: pto.alloc_tile addr = %[[EXEC_SCRATCH_ADDR]]

// CHECK-LABEL: func.func @while_result_and_backedge_alias_no_reuse
// CHECK-DAG: %[[WHILE_INIT_ADDR:.*]] = arith.constant 0 : i64
// CHECK-DAG: %[[WHILE_NEXT_ADDR:.*]] = arith.constant 512 : i64
// CHECK-DAG: %[[WHILE_SCRATCH_ADDR:.*]] = arith.constant 1024 : i64
// CHECK: pto.alloc_tile addr = %[[WHILE_INIT_ADDR]]
// CHECK: scf.while
// CHECK: pto.alloc_tile addr = %[[WHILE_NEXT_ADDR]]
// CHECK: pto.alloc_tile addr = %[[WHILE_SCRATCH_ADDR]]
