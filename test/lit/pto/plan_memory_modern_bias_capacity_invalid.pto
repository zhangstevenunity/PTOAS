// RUN: not ptoas --pto-level=level2 --pto-arch=a3 \
// RUN:   --emit-pto-ir %s 2>&1 | FileCheck %s

module {
  func.func @bias_capacity_overflow() {
    %too_large = pto.alloc_tile : !pto.tile_buf<bias, 1x262144xf32>
    return
  }
}

// CHECK: bias overflow, requires 8388608 bits while 524288 bits available
